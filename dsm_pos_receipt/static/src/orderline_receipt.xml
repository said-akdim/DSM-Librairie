<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Ligne compacte (remise regroupée) : pas de ligne « qté x prix / Unité(s) » -->
    <t t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//li[hasclass('price-per-unit')]" position="attributes">
            <attribute name="t-if">!line.dsmCompact</attribute>
        </xpath>
    </t>
</templates>
