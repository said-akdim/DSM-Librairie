<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_delivery_price_rule_form_city" model="ir.ui.view">
        <field name="name">delivery.price.rule.form.city</field>
        <field name="model">delivery.price.rule</field>
        <field name="inherit_id" ref="delivery.view_delivery_price_rule_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='variable']" position="before">
                <field name="city_names" placeholder="Toutes les villes"/>
            </xpath>
        </field>
    </record>

    <record id="view_delivery_price_rule_tree_city" model="ir.ui.view">
        <field name="name">delivery.price.rule.list.city</field>
        <field name="model">delivery.price.rule</field>
        <field name="inherit_id" ref="delivery.view_delivery_price_rule_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="city_names" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
