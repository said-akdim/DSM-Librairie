# ══════════════════════════════════════
# BORNE DE PRIX DSM — configuration d'un appareil
# Copier en .env sur la borne (ou passer ces variables au moment du build)
# ══════════════════════════════════════

# Serveur Odoo 18 vu depuis la borne
EXPO_PUBLIC_ODOO_URL=http://94.130.90.253:9069
EXPO_PUBLIC_ODOO_DB=agora-prod

# Compte de service Odoo — utilisateur EN LECTURE SEULE, jamais l'admin
EXPO_PUBLIC_ODOO_LOGIN=borne
EXPO_PUBLIC_ODOO_PASSWORD=a_remplacer
