<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         Vue liste des sessions
    ════════════════════════════════════════════════════════════════════ -->
    <record id="view_school_supply_session_list" model="ir.ui.view">
        <field name="name">dsm.school.supply.session.list</field>
        <field name="model">dsm.school.supply.session</field>
        <field name="arch" type="xml">
            <list string="Commandes fournitures scolaires"
                  decoration-muted="state == 'draft'"
                  decoration-success="state == 'po_created'">
                <field name="name"/>
                <field name="school_year"/>
                <field name="line_count" string="Lignes"/>
                <field name="ok_count" string="OK"/>
                <field name="error_count" string="Erreurs"
                       decoration-danger="error_count &gt; 0"/>
                <field name="po_count" string="Bons de commande"/>
                <field name="state" widget="badge"
                       decoration-secondary="state == 'draft'"
                       decoration-warning="state == 'imported'"
                       decoration-success="state == 'po_created'"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         Vue formulaire d'une session
    ════════════════════════════════════════════════════════════════════ -->
    <record id="view_school_supply_session_form" model="ir.ui.view">
        <field name="name">dsm.school.supply.session.form</field>
        <field name="model">dsm.school.supply.session</field>
        <field name="arch" type="xml">
            <form string="Session de commande scolaire">
                <header>
                    <!-- Import / Recalcul -->
                    <button name="action_import_excel" type="object"
                            string="📥 Importer Excel"
                            class="btn-primary"
                            invisible="state == 'po_created'"/>
                    <button name="action_recompute_stock" type="object"
                            string="🔄 Recalculer le stock"
                            invisible="state == 'draft'"/>
                    <button name="action_reset_adjusted_qty" type="object"
                            string="↺ Réinitialiser les quantités"
                            invisible="state == 'draft'"/>
                    <!-- Génération des bons -->
                    <button name="action_create_purchase_orders" type="object"
                            string="✅ Générer les bons de commande"
                            class="btn-primary"
                            invisible="state != 'imported'"/>
                    <!-- Navigation vers les bons -->
                    <button name="action_view_purchase_orders" type="object"
                            string="Voir les bons de commande"
                            invisible="po_count == 0"/>
                    <!-- Retour brouillon -->
                    <button name="action_reset_to_draft" type="object"
                            string="Remettre en brouillon"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,imported,po_created"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_purchase_orders"
                                icon="fa-shopping-cart"
                                invisible="po_count == 0">
                            <field name="po_count" widget="statinfo"
                                   string="Bons de commande"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Référence session…"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Identification">
                            <field name="school_year"/>
                        </group>
                        <group string="Statistiques">
                            <field name="line_count" readonly="1"/>
                            <field name="ok_count" readonly="1"/>
                            <field name="error_count" readonly="1"
                                   decoration-danger="error_count &gt; 0"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Lignes de commande" name="lines">
                            <!-- Bandeau d'alerte si des erreurs existent -->
                            <div class="alert alert-warning" role="alert"
                                 invisible="error_count == 0">
                                <i class="fa fa-exclamation-triangle"/>
                                <b><field name="error_count" readonly="1"/> article(s) non trouvé(s)</b>
                                — vérifiez les codes EAN13 dans Odoo.
                            </div>

                            <list name="lines" editable="bottom"
                                  decoration-danger="state == 'error'"
                                  decoration-warning="state == 'warning'"
                                  default_order="supplier_id, school_name">
                                <field name="school_name" optional="show"/>
                                <field name="barcode"/>
                                <field name="product_name" readonly="1"/>
                                <field name="product_id" optional="hide"/>
                                <field name="supplier_id" readonly="1"/>
                                <field name="last_year_qty" sum="Total N-1"/>
                                <field name="current_stock" readonly="1" sum="Total stock"/>
                                <field name="estimated_qty" readonly="1" sum="Total estimé"/>
                                <field name="adjusted_qty" sum="Total commandé"/>
                                <field name="price_unit"/>
                                <field name="state" widget="badge"
                                       decoration-danger="state == 'error'"
                                       decoration-warning="state == 'warning'"
                                       decoration-success="state == 'ok'"/>
                                <field name="message" optional="show" readonly="1"/>
                            </list>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Notes internes…"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         Action principale
    ════════════════════════════════════════════════════════════════════ -->
    <record id="action_school_supply_session" model="ir.actions.act_window">
        <field name="name">Commandes Fournitures Scolaires</field>
        <field name="res_model">dsm.school.supply.session</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer une nouvelle session de commande scolaire
            </p>
            <p>
                Importez votre fichier Excel (EAN13 | École | Qté N-1)
                pour générer automatiquement vos pré-bons de commande fournisseurs.
            </p>
        </field>
    </record>

</odoo>
