<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dsm_whatsapp_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.whatsapp.standalone</field>
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <form string="Notifications clients DSM">
                <header>
                    <button string="Enregistrer" name="execute" type="object" class="btn btn-primary" data-hotkey="s"/>
                    <button string="Annuler" name="cancel" type="object" class="btn btn-secondary" data-hotkey="j"/>
                </header>
                <sheet>
                    <h2>Notifications clients DSM</h2>

                    <!-- Activation -->
                    <group>
                        <field name="whatsapp_enabled" string="Activer les notifications clients (WhatsApp / SMS)"/>
                    </group>

                    <!-- Mode d'envoi -->
                    <group string="Canal de notification" invisible="not whatsapp_enabled">
                        <field name="notification_mode" widget="radio" nolabel="1"/>
                    </group>

                    <!-- Section WhatsApp Business -->
                    <group string="WhatsApp Business (Meta)"
                           invisible="not whatsapp_enabled or notification_mode == 'sms'">
                        <group>
                            <field name="whatsapp_token" password="True" placeholder="EAABxxxxxx..."/>
                            <field name="whatsapp_phone_id" placeholder="123456789012345"/>
                            <field name="whatsapp_default_country" placeholder="212"/>
                            <field name="whatsapp_api_url" placeholder="https://graph.facebook.com/v19.0"/>
                        </group>
                        <div>
                            <button name="action_test_whatsapp"
                                    string="Tester la connexion WhatsApp"
                                    type="object"
                                    class="btn btn-secondary mt8"/>
                        </div>
                    </group>

                    <!-- Section SMS Inwi -->
                    <group string="SMS via Inwi Business"
                           invisible="not whatsapp_enabled or notification_mode == 'whatsapp'">
                        <group>
                            <field name="sms_api_url" placeholder="https://api.inwi.ma/sms/send"/>
                            <field name="sms_login" placeholder="votre_login_inwi"/>
                            <field name="sms_password" password="True"/>
                            <field name="sms_sender" placeholder="DSM"/>
                        </group>
                        <div>
                            <button name="action_test_sms"
                                    string="Tester SMS Inwi"
                                    type="object"
                                    class="btn btn-secondary mt8"/>
                        </div>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dsm_whatsapp_settings" model="ir.actions.act_window">
        <field name="name">Paramètres WhatsApp DSM</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_dsm_whatsapp_settings_form"/>
        <field name="target">inline</field>
    </record>

</odoo>
