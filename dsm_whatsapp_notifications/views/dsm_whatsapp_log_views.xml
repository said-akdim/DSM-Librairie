<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Liste des logs -->
    <record id="view_dsm_whatsapp_log_list" model="ir.ui.view">
        <field name="name">dsm.whatsapp.log.list</field>
        <field name="model">dsm.whatsapp.log</field>
        <field name="arch" type="xml">
            <list string="Journal des messages" default_order="date_envoi desc"
                  decoration-danger="statut == 'erreur'" decoration-muted="statut == 'desactive'">
                <field name="date_envoi"/>
                <field name="canal" widget="badge"
                    decoration-success="canal == 'whatsapp'"
                    decoration-info="canal == 'sms'"/>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="event"/>
                <field name="sale_order_id"/>
                <field name="statut" widget="badge"
                    decoration-success="statut == 'succes'"
                    decoration-danger="statut == 'erreur'"
                    decoration-warning="statut == 'desactive'"/>
            </list>
        </field>
    </record>

    <!-- Formulaire log -->
    <record id="view_dsm_whatsapp_log_form" model="ir.ui.view">
        <field name="name">dsm.whatsapp.log.form</field>
        <field name="model">dsm.whatsapp.log</field>
        <field name="arch" type="xml">
            <form string="Message envoyé" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Destinataire">
                            <field name="partner_id"/>
                            <field name="phone"/>
                            <field name="sale_order_id"/>
                        </group>
                        <group string="Envoi">
                            <field name="canal" widget="badge"
                                decoration-success="canal == 'whatsapp'"
                                decoration-info="canal == 'sms'"/>
                            <field name="event"/>
                            <field name="date_envoi"/>
                            <field name="statut" widget="badge"
                                decoration-success="statut == 'succes'"
                                decoration-danger="statut == 'erreur'"
                                decoration-warning="statut == 'desactive'"/>
                        </group>
                    </group>
                    <group string="Contenu du message">
                        <field name="message" nolabel="1" widget="text"/>
                    </group>
                    <group string="Détail erreur" invisible="not erreur_detail">
                        <field name="erreur_detail" nolabel="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_dsm_whatsapp_log" model="ir.actions.act_window">
        <field name="name">Journal des messages</field>
        <field name="res_model">dsm.whatsapp.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun message envoyé pour l'instant.
            </p>
        </field>
    </record>

</odoo>
