<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="mail_template_carte_fidelite" model="mail.template">
    <field name="name">DSM – Carte de fidélité virtuelle</field>
    <field name="model_id" ref="base.model_res_partner"/>
    <field name="subject">🎉 Votre carte fidélité Librairie DSM – {{ object.name }}</field>
    <field name="email_to">{{ object.email }}</field>
    <field name="email_from">librairie.dsm@gmail.com</field>
    <field name="body_html" type="html">
<t t-name="mail.template">
<div style="margin:0;padding:0;background:#f4f4f4;font-family:'Helvetica Neue',Arial,sans-serif;">

  <!-- ── Wrapper ── -->
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f4;padding:32px 0;">
    <tr><td align="center">
      <table width="520" cellpadding="0" cellspacing="0" style="max-width:520px;width:100%;">

        <!-- ══ CARTE ══ -->
        <tr><td>
          <div style="
            background: linear-gradient(145deg, #c0392b 0%, #8b0000 60%, #6b0000 100%);
            border-radius: 20px;
            padding: 36px 32px 32px 32px;
            position: relative;
            box-shadow: 0 12px 40px rgba(0,0,0,0.35);
            overflow: hidden;
          ">

            <!-- Watermark text -->
            <div style="
              position:absolute; top:50%; left:50%;
              transform:translate(-50%,-50%) rotate(-10deg);
              font-size:96px; font-weight:900; color:rgba(255,255,255,0.06);
              letter-spacing:-4px; white-space:nowrap; pointer-events:none;
              font-family:'Helvetica Neue',Arial,sans-serif;
              line-height:1;
            ">DSM</div>

            <!-- ── Ligne 1 : Logo + Niveau + Numéro ── -->
            <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:24px;">
              <tr>
                <td valign="middle" width="80">
                  <img src="data:image/jpeg;base64,"
                       width="70" height="70"
                       style="border-radius:12px;display:block;border:2px solid rgba(255,255,255,0.3);"
                       alt="Logo DSM"/>
                </td>
                <td valign="top" align="right" style="padding-left:12px;">
                  <div style="color:rgba(255,255,255,0.75);font-size:11px;font-weight:600;
                              letter-spacing:2px;text-transform:uppercase;margin-bottom:4px;">
                    <t t-out="object.dsm_niveau.upper() if object.dsm_niveau else 'BRONZE'"/>
                  </div>
                  <div style="color:#fff;font-size:20px;font-weight:700;letter-spacing:2px;">
                    <t t-out="object.dsm_num_carte or '—'"/>
                  </div>
                </td>
              </tr>
            </table>

            <!-- ── Ligne 2 : Sous-titre librairie ── -->
            <div style="color:rgba(255,255,255,0.6);font-size:11px;letter-spacing:3px;
                        text-transform:uppercase;margin-bottom:4px;">
              Librairie · Papeterie
            </div>

            <!-- ── Ligne 3 : Niveau en grand ── -->
            <div style="color:#fff;font-size:40px;font-weight:900;letter-spacing:3px;
                        text-transform:uppercase;margin-bottom:20px;line-height:1.1;">
              <t t-out="object.dsm_niveau.upper() if object.dsm_niveau else 'BRONZE'"/>
            </div>

            <!-- ── Ligne 4 : Nom client ── -->
            <div style="color:rgba(255,255,255,0.7);font-size:11px;font-weight:600;
                        letter-spacing:2px;text-transform:uppercase;margin-bottom:6px;">
              NOM
            </div>
            <div style="color:#fff;font-size:22px;font-weight:700;letter-spacing:1px;margin-bottom:28px;">
              <t t-out="(object.name or '').upper()"/>
            </div>

            <!-- ── QR Code + numéro ── -->
            <table width="100%" cellpadding="0" cellspacing="0">
              <tr>
                <td align="center">
                  <div style="
                    background:#fff;
                    border-radius:12px;
                    padding:14px;
                    display:inline-block;
                    box-shadow:0 4px 16px rgba(0,0,0,0.3);
                  ">
                    <t t-if="object.dsm_carte_qr">
                      <img t-att-src="'data:image/png;base64,' + object.dsm_carte_qr.decode() if hasattr(object.dsm_carte_qr, 'decode') else 'data:image/png;base64,' + object.dsm_carte_qr"
                           width="160" height="160"
                           style="display:block;"
                           alt="QR Code carte DSM"/>
                    </t>
                    <t t-else="">
                      <div style="width:160px;height:160px;display:flex;align-items:center;
                                  justify-content:center;color:#999;font-size:12px;">
                        QR non disponible
                      </div>
                    </t>
                    <div style="text-align:center;color:#333;font-size:14px;font-weight:700;
                                letter-spacing:3px;margin-top:8px;font-family:monospace;">
                      <t t-out="object.dsm_num_carte or '—'"/>
                    </div>
                  </div>
                </td>
              </tr>
            </table>

            <!-- ── Points & Solde ── -->
            <table width="100%" cellpadding="0" cellspacing="0" style="margin-top:24px;">
              <tr>
                <td align="center" style="padding:0 8px;">
                  <div style="background:rgba(255,255,255,0.15);border-radius:12px;padding:12px 0;">
                    <div style="color:#fff;font-size:24px;font-weight:800;">
                      <t t-out="object.dsm_points or 0"/>
                    </div>
                    <div style="color:rgba(255,255,255,0.7);font-size:11px;letter-spacing:1px;
                                text-transform:uppercase;margin-top:2px;">Points</div>
                  </div>
                </td>
                <td align="center" style="padding:0 8px;">
                  <div style="background:rgba(255,255,255,0.15);border-radius:12px;padding:12px 0;">
                    <div style="color:#fff;font-size:24px;font-weight:800;">
                      <t t-out="'%.2f DH' % (object.dsm_solde or 0)"/>
                    </div>
                    <div style="color:rgba(255,255,255,0.7);font-size:11px;letter-spacing:1px;
                                text-transform:uppercase;margin-top:2px;">Solde</div>
                  </div>
                </td>
                <td align="center" style="padding:0 8px;">
                  <div style="background:rgba(255,255,255,0.15);border-radius:12px;padding:12px 0;">
                    <div style="color:#fff;font-size:16px;font-weight:800;">
                      <t t-out="object.dsm_membre_depuis.strftime('%m/%Y') if object.dsm_membre_depuis else '—'"/>
                    </div>
                    <div style="color:rgba(255,255,255,0.7);font-size:11px;letter-spacing:1px;
                                text-transform:uppercase;margin-top:2px;">Membre</div>
                  </div>
                </td>
              </tr>
            </table>

          </div>
        </td></tr>
        <!-- ══ FIN CARTE ══ -->

        <!-- ── Message bas ── -->
        <tr><td style="padding:28px 16px 0 16px;text-align:center;">
          <p style="color:#555;font-size:14px;line-height:1.7;margin:0 0 16px 0;">
            Bonjour <strong><t t-out="object.name"/></strong>,<br/>
            Voici votre carte de fidélité virtuelle <strong>Librairie DSM</strong>.<br/>
            Présentez le QR code en caisse pour cumuler vos points à chaque achat.
          </p>
          <table cellpadding="0" cellspacing="0" style="margin:0 auto;">
            <tr><td style="background:#c0392b;border-radius:8px;padding:12px 28px;">
              <a href="http://94.130.90.253:9069"
                 style="color:#fff;text-decoration:none;font-weight:700;font-size:14px;
                        letter-spacing:1px;">
                Accéder à mon espace fidélité
              </a>
            </td></tr>
          </table>
        </td></tr>

        <!-- ── Pied ── -->
        <tr><td style="padding:24px 16px;text-align:center;">
          <p style="color:#aaa;font-size:11px;margin:0;">
            © Librairie Papeterie D.S.M · librairie.dsm@gmail.com<br/>
            Ce message est envoyé automatiquement, merci de ne pas y répondre.
          </p>
        </td></tr>

      </table>
    </td></tr>
  </table>
</div>
</t>
    </field>
  </record>

</odoo>
