<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dsm_livre_prefere_list" model="ir.ui.view">
        <field name="name">dsm.livre.prefere.list</field>
        <field name="model">dsm.livre.prefere</field>
        <field name="arch" type="xml">
            <list string="Livres préférés" default_order="qte_totale desc">
                <field name="product_id"/>
                <field name="genre"/>
                <field name="auteur"/>
                <field name="nb_achats" string="Nb commandes"/>
                <field name="qte_totale" string="Qté achetée"/>
                <field name="montant_total" string="Montant (DH)"/>
                <field name="date_dernier_achat" string="Dernier achat"/>
            </list>
        </field>
    </record>

</odoo>
