<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="dsm_pos_global_discount.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/OrderlineNoteButton" position="after">
            <button class="dsm_global_discount"
                t-att-class="buttonClass"
                t-on-click="() => this.clickDsmGlobalDiscount()">
                <i class="fa fa-percent me-1"/>Remise globale
            </button>
        </xpath>
    </t>
</templates>
